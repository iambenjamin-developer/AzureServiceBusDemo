# Copia este archivo como ".env" (está en .gitignore) y pon tu API key.
# docker compose lee ".env" automáticamente.

# Organization Settings → API Keys en Datadog
DD_API_KEY=

# Región de tu cuenta: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu...
DD_SITE=datadoghq.com

# Etiqueta "env" de todo lo que mande el Agent
DD_ENV=dev

# Nombre del host en Datadog (en Docker Desktop el Agent no siempre lo detecta solo)
DD_HOSTNAME=dev-local
